---
title: "Inscription aux permanences"
description: "Inscrivez-vous aux permanences juridiques d'ESSOR : accompagnement des demandeurs d'asile en Ile-de-France."
layout: base.njk
permalink: /inscription/
extra_css:
  - { href: "/css/forms.css" }
extra_js:
  - /js/inscription.js
---

{% set p = pages.inscription %}

<!-- Hero -->
<section class="hero hero-sm">
    <div class="hero-bg">
        <img src="{{ p.hero.image }}" alt="">
    </div>
    <div class="container">
        <h1>{{ p.hero.titre }}</h1>
        <p class="lead">{{ p.hero.lead }}</p>
    </div>
</section>

<main class="page-content">
    <section class="section">
        <div class="container">

            <!-- Sélecteur type d'usager -->
            <div class="section-title">
                <h2>Vous &ecirc;tes&hellip;</h2>
            </div>
            <div class="user-type-selector reveal">
                <div class="user-type-card selected" data-type="beneficiaire" tabindex="0" role="button" aria-pressed="true">
                    <div class="user-type-icon">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <h3>Demandeur d'asile</h3>
                    <p>Je souhaite &ecirc;tre accompagn&eacute; dans mes d&eacute;marches</p>
                </div>
                <div class="user-type-card benevole" data-type="benevole" tabindex="0" role="button" aria-pressed="false">
                    <div class="user-type-icon">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    </div>
                    <h3>B&eacute;n&eacute;vole juriste</h3>
                    <p>Je souhaite donner de mon temps</p>
                </div>
            </div>

            <!-- Formulaire bénéficiaire -->
            <div id="form-beneficiaire" style="max-width: 650px; margin: 0 auto;">
                <div class="form-card reveal">
                    <h3 class="mb-3">Inscription &mdash; B&eacute;n&eacute;ficiaire</h3>
                    <form id="inscription-beneficiaire" name="inscription-beneficiaire" method="POST" data-netlify="true" netlify-honeypot="bot-field">
                        <p class="hidden"><label>Ne pas remplir : <input name="bot-field"></label></p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="ins-prenom" class="form-label">Pr&eacute;nom <span class="required">*</span></label>
                                <input type="text" id="ins-prenom" name="prenom" class="form-input" required>
                            </div>
                            <div class="form-group">
                                <label for="ins-nom" class="form-label">Nom <span class="required">*</span></label>
                                <input type="text" id="ins-nom" name="nom" class="form-input" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="ins-telephone" class="form-label">T&eacute;l&eacute;phone <span class="required">*</span></label>
                                <input type="tel" id="ins-telephone" name="telephone" class="form-input" required>
                            </div>
                            <div class="form-group">
                                <label for="ins-email" class="form-label">Email</label>
                                <input type="email" id="ins-email" name="email" class="form-input">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="ins-nationalite" class="form-label">Nationalit&eacute; <span class="required">*</span></label>
                            <input type="text" id="ins-nationalite" name="nationalite" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label for="ins-type-demande" class="form-label">Type de demande <span class="required">*</span></label>
                            <select id="ins-type-demande" name="type_demande" class="form-input" required>
                                <option value="">-- Choisir --</option>
                                <option value="premiere-demande">Premi&egrave;re demande d'asile</option>
                                <option value="recours">Recours CNDA</option>
                                <option value="reexamen">R&eacute;examen</option>
                                <option value="autre">Autre / Je ne sais pas</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="ins-creneau" class="form-label">Cr&eacute;neau souhait&eacute; <span class="required">*</span></label>
                            <select id="ins-creneau" name="creneau" class="form-input" required>
                                <option value="">-- Choisir un cr&eacute;neau --</option>
                                {% for creneau in site.creneaux %}
                                <option value="{{ creneau.value }}">{{ creneau.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="ins-message" class="form-label">Message (facultatif)</label>
                            <textarea id="ins-message" name="message" class="form-input" rows="3" placeholder="D&eacute;crivez bri&egrave;vement votre situation..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-vermillon btn-lg" style="width: 100%; justify-content: center;">Envoyer mon inscription</button>
                    </form>
                    <div id="confirmation-beneficiaire" class="form-confirmation hidden">
                        <div class="confirmation-icon">&#10003;</div>
                        <h3>Inscription envoy&eacute;e</h3>
                        <p>Merci ! Nous avons bien re&ccedil;u votre demande d'inscription. Nous vous recontacterons pour confirmer votre cr&eacute;neau.</p>
                    </div>
                </div>
            </div>

            <!-- Formulaire bénévole -->
            <div id="form-benevole" class="hidden" style="max-width: 650px; margin: 0 auto;">
                <div class="form-card reveal">
                    <h3 class="mb-3">Inscription &mdash; B&eacute;n&eacute;vole juriste</h3>
                    <form id="inscription-benevole" name="inscription-benevole" method="POST" data-netlify="true" netlify-honeypot="bot-field">
                        <p class="hidden"><label>Ne pas remplir : <input name="bot-field"></label></p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="ben-prenom" class="form-label">Pr&eacute;nom <span class="required">*</span></label>
                                <input type="text" id="ben-prenom" name="prenom" class="form-input" required>
                            </div>
                            <div class="form-group">
                                <label for="ben-nom" class="form-label">Nom <span class="required">*</span></label>
                                <input type="text" id="ben-nom" name="nom" class="form-input" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="ben-email" class="form-label">Email <span class="required">*</span></label>
                                <input type="email" id="ben-email" name="email" class="form-input" required>
                            </div>
                            <div class="form-group">
                                <label for="ben-telephone" class="form-label">T&eacute;l&eacute;phone <span class="required">*</span></label>
                                <input type="tel" id="ben-telephone" name="telephone" class="form-input" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="ben-statut" class="form-label">Statut professionnel <span class="required">*</span></label>
                            <select id="ben-statut" name="statut" class="form-input" required>
                                <option value="">-- Choisir --</option>
                                <option value="etudiant">&Eacute;tudiant en droit</option>
                                <option value="avocat">Avocat</option>
                                <option value="juriste">Juriste</option>
                                <option value="autre">Autre</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sp&eacute;cialit&eacute;s</label>
                            <div class="form-checkboxes">
                                <label class="form-checkbox">
                                    <input type="checkbox" name="specialites" value="droit-asile"> Droit d'asile
                                </label>
                                <label class="form-checkbox">
                                    <input type="checkbox" name="specialites" value="droit-etrangers"> Droit des &eacute;trangers
                                </label>
                                <label class="form-checkbox">
                                    <input type="checkbox" name="specialites" value="droit-social"> Droit social
                                </label>
                                <label class="form-checkbox">
                                    <input type="checkbox" name="specialites" value="interpretation"> Interpr&eacute;tation
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="ben-disponibilites" class="form-label">Disponibilit&eacute;s <span class="required">*</span></label>
                            <input type="text" id="ben-disponibilites" name="disponibilites" class="form-input" required placeholder="Ex : Mardi apr&egrave;s-midi, 2 fois par mois">
                        </div>
                        <div class="form-group">
                            <label for="ben-motivation" class="form-label">Motivation</label>
                            <textarea id="ben-motivation" name="motivation" class="form-input" rows="4" placeholder="Pourquoi souhaitez-vous rejoindre ESSOR ?"></textarea>
                        </div>
                        <button type="submit" class="btn btn-or btn-lg" style="width: 100%; justify-content: center;">Envoyer ma candidature</button>
                    </form>
                    <div id="confirmation-benevole" class="form-confirmation hidden">
                        <div class="confirmation-icon">&#10003;</div>
                        <h3>Candidature envoy&eacute;e</h3>
                        <p>Merci pour votre int&eacute;r&ecirc;t ! Nous reviendrons vers vous tr&egrave;s prochainement pour organiser votre int&eacute;gration.</p>
                    </div>
                </div>
            </div>

        </div>
    </section>
</main>

