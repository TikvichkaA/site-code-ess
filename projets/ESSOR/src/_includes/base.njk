<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% if page.url == "/" %}{{ title }}{% else %}{{ title }} - ESSOR{% endif %}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ description | default('ESSOR accompagne les demandeurs d\'asile en Ile-de-France : aide juridique, administrative et cours de français.') }}{% endblock %}">
    <link rel="stylesheet" href="/css/common.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
    {% if extra_css %}{% for css_file in extra_css %}
    <link rel="stylesheet" href="{{ css_file.href }}"{% if css_file.media %} media="{{ css_file.media }}"{% endif %}>
    {% endfor %}{% endif %}
</head>
<body>

    {% include "header.njk" %}

    {{ content | safe }}

    {% include "footer.njk" %}

    <script src="/js/navigation.js"></script>
    <script src="/js/animations.js"></script>
    {% if extra_js %}{% for js_file in extra_js %}
    <script src="{{ js_file }}"></script>
    {% endfor %}{% endif %}
</body>
</html>
